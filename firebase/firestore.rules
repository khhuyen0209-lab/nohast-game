rules_version = '2';
// Nohast Firestore Security Rules (spec §40).
// Principle: server (Firebase Admin) is authoritative. Client NEVER writes
// balances, assets, admin rights, combat results, or Nohast campaign state.
// Client may READ only its own data + public world data.
service cloud.firestore {
  match /databases/{database}/documents {

    // Player profile: owner read-only.
    match /players/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false; // server only
    }
    // Player subcollections (ships, stations, crew, transactions): owner read-only.
    match /players/{uid}/{sub}/{docId} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Wallet: owner read-only.
    match /wallets/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Public world data: any authenticated user may read.
    match /world/{doc=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Factions & alliances: public read.
    match /factions/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /alliances/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Presence: authenticated read (for online lists), server writes.
    match /presence/{uid} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Chat history: authenticated read (server writes via WS/HTTP).
    match /chat/{doc=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Default: deny everything else.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
