# ============================================================
# NOHAST — Biến môi trường mẫu (spec §42).
# Copy file này thành server/.env (local dev) hoặc đặt vào Render Environment.
# KHÔNG commit file .env thật, KHÔNG đưa khóa riêng vào repo/ZIP.
# ============================================================

# --- Server (Render) ---
PORT=10000
NODE_ENV=development
# Các origin được phép gọi API (cách nhau bằng dấu phẩy). Bao gồm cả localhost cho dev.
CORS_ORIGINS=https://nohast-galaxy-c6c9f.web.app,https://nohast-galaxy-c6c9f.firebaseapp.com,http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=https://nohast-galaxy-c6c9f.web.app
API_URL=https://nohast-game.onrender.com

# --- Firebase Admin (backend) ---
# Lấy từ Firebase Console → Project Settings → Service accounts → Generate new private key.
FIREBASE_PROJECT_ID=nohast-galaxy-c6c9f
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@nohast-galaxy-c6c9f.iam.gserviceaccount.com
# Dán nguyên nội dung private key (gồm -----BEGIN PRIVATE KEY----- ...). Render tự xử lý xuống dòng.
FIREBASE_PRIVATE_KEY=

# --- Đặt MEMORY_STORE=1 để chạy local KHÔNG cần Firebase (dữ liệu trong RAM, mất khi restart) ---
# Khi FIREBASE_PRIVATE_KEY trống, server tự động dùng memory store.
# MEMORY_STORE=1

# --- Tùy chọn ---
RATE_LIMIT_PER_MINUTE=120
CHAT_RATE_PER_MIN=20
